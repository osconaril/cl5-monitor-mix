{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CL5 Monitor Mix",
  "version": "0.1.0",
  "identifier": "cl5.monitor.mix",
  "build": {
    "frontendDist": "resources/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CL5 Monitor Mix",
        "width": 480,
        "height": 820,
        "resizable": true,
        "url": "http://127.0.0.1:8787/"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/cl5-server"
    ],
    "resources": [
      "resources/web"
    ]
  }
}
